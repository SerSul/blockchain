# Нода 1 — genesis (порт 8080). Скопируйте: copy docker\env.node1.example .env.node1
COMPOSE_PROJECT_NAME=bc-node1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=blockchain_db
DB_HOST_PORT=5433

APP_PORT=8080
LEVELDB_PATH=/data/leveldb

BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_0=ВСТАВЬТЕ_public_b64_validator1
BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_1=ВСТАВЬТЕ_public_b64_validator2
BLOCKCHAIN_BOOTSTRAP_PEERS_0=
BLOCKCHAIN_BOOTSTRAP_SYNC_ENABLED=false

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blockchain-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
