# Нода 2 — присоединение к ноде 1 (порт 8081). Скопируйте: copy docker\env.node2.example .env.node2
COMPOSE_PROJECT_NAME=bc-node2

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_NAME=blockchain_db
DB_HOST_PORT=5434

APP_PORT=8081
LEVELDB_PATH=/data/leveldb

# Ключи не обязательны — подтянутся с ноды 1 (join-snapshot + блоки)
BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_0=
BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_1=

# Windows / Mac Docker Desktop:
BLOCKCHAIN_BOOTSTRAP_PEERS_0=http://host.docker.internal:8080
# Linux (при необходимости): http://172.17.0.1:8080

BLOCKCHAIN_BOOTSTRAP_SYNC_ENABLED=true
BLOCKCHAIN_SYNC_INTERVAL_MS=5000
BLOCKCHAIN_BOOTSTRAP_SYNC_BATCH_SIZE=100

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=blockchain-files
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
