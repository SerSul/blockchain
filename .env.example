# Шаблон для одной ноды (скопируйте в .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password

DB_NAME=blockchain_db
DB_HOST_PORT=5433

APP_PORT=8080
LEVELDB_PATH=/data/leveldb

# Первая нода в сети — укажите публичные ключи (python scripts/generate_keys.py)
BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_0=
BLOCKCHAIN_BOOTSTRAP_VALIDATOR_PUBLIC_KEYS_1=

# Две ноды: у каждой свой .env (см. docker/README.md)
#   нода 1: PEERS_0=http://host.docker.internal:8081, SYNC=true + ключи валидаторов
#   нода 2: PEERS_0=http://host.docker.internal:8080, SYNC=true, ключи можно не задавать

BLOCKCHAIN_BOOTSTRAP_PEERS_0=
BLOCKCHAIN_BOOTSTRAP_SYNC_ENABLED=false
BLOCKCHAIN_SYNC_INTERVAL_MS=5000
BLOCKCHAIN_BOOTSTRAP_SYNC_BATCH_SIZE=100

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_strong_minio_password
MINIO_BUCKET=blockchain-files
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
